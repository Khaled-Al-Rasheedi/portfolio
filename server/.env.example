# Copy this file to server/.env and replace these placeholders.
# Neon: use Connect > Connection string from the Neon dashboard.
# Local PostgreSQL example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/porsche_portfolio
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Assignment 4, test mode only. NEVER commit your real secrets.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
# CLIENT_ORIGIN must be the exact Vercel production URL on Render.
