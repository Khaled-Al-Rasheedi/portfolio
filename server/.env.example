# Copy this file to server/.env and replace these placeholders.
# Neon: use Connect > Connection string from the Neon dashboard.
# Local PostgreSQL example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/porsche_portfolio
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
